# Postgres connection string (Neon, Supabase, Vercel Postgres...). Use sslmode=require for hosted DBs.
DATABASE_URL=postgres://user:password@host:5432/placepoint?sslmode=require

# NIPOST API key from https://dashboard.postcode.gov.ng (Settings → API Keys). Server-side only.
# Test keys (nipost_test_...) only resolve the sandbox dataset; live keys need KYB.
NIPOST_API_KEY=

# Set to 1 to use built-in sample NIPOST responses for local demos (no key needed).
NIPOST_MOCK=

# Random string used to hash IPs for rate limiting.
IP_HASH_SALT=

# Public URL of the deployment, used in API responses and share links.
NEXT_PUBLIC_SITE_URL=https://placepoint.ng
NEXT_PUBLIC_CONTACT_EMAIL=
